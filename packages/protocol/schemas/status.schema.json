{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bluecarbonsentinel.local/schemas/status.schema.json",
  "title": "Status",
  "description": "bcs.status.v1 (addendum G3): node to Ground Station, retained; also the last will.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "site_id", "node_id", "state", "at", "reason", "mode", "interval_s", "fw_version", "boot_id", "source", "replay"],
  "properties": {
    "schema": { "const": "bcs.status.v1" },
    "site_id": { "$ref": "common.schema.json#/$defs/SiteId" },
    "node_id": { "$ref": "common.schema.json#/$defs/NodeId" },
    "state": { "type": "string", "enum": ["online", "offline"] },
    "at": { "$ref": "common.schema.json#/$defs/IsoTime" },
    "reason": { "anyOf": [{ "type": "string", "enum": ["last_will", "shutdown"] }, { "type": "null" }] },
    "mode": { "anyOf": [{ "$ref": "common.schema.json#/$defs/Mode" }, { "type": "null" }] },
    "interval_s": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "fw_version": { "type": "string", "maxLength": 32 },
    "boot_id": { "$ref": "common.schema.json#/$defs/BootId" },
    "source": { "$ref": "common.schema.json#/$defs/Source" },
    "replay": { "type": "boolean" }
  }
}
