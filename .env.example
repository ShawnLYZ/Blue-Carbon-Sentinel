# Blue Carbon Sentinel settings. Every credential and API key goes in this file, and nowhere else.
# How to use it: make a copy of this file named .env in this same folder, then fill in the copy.
# Paste each value right after the = sign, with no spaces and no quotes. README.md explains every line.
# Never upload .env or share it. It is listed in .gitignore, so git leaves it out.

# 1. Google Gemini, the AI that interprets camera images and sensor readings.
#    Get keys at https://aistudio.google.com/apikey. Key 1 is required; keys 2 and 3 are backups.
BCS_GEMINI_API_KEY_1=
BCS_GEMINI_API_KEY_2=
BCS_GEMINI_API_KEY_3=

# 2. Supabase, the cloud copy of the data. https://supabase.com/dashboard
#    The project URL looks like https://abcdefghijklmnopqrst.supabase.co (nothing after .co).
BCS_SUPABASE_URL=
BCS_SUPABASE_SERVICE_ROLE_KEY=
BCS_SUPABASE_ANON_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# 3. NVIDIA, which draws the future-view images. The key starts with nvapi-  https://build.nvidia.com
BCS_NVIDIA_API_KEY=

# 4. Mapbox, the 3D map. The default public token starts with pk.  https://account.mapbox.com/access-tokens
BCS_MAPBOX_PUBLIC_TOKEN=

# 5. Passwords you make up yourself. Use a different random value on each line: at least 32 letters
#    and digits, no spaces and no symbols. README.md shows how to generate them.
BCS_BROKER_ADMIN_USER=admin
BCS_BROKER_ADMIN_PASSWORD=
BCS_GS_MQTT_PASSWORD=
BCS_SIM_SHARED_TOKEN=
BCS_CAMERA_TOKEN=
BCS_CAMERA_OTA_PASSWORD=

# 6. Options. These values work as they are; change them only if you need to.
BCS_CAMERA_HOST=sentinel-cam.local
BCS_CAMERA_IP=
BCS_DEMO_TIME_SCALE=on
BCS_LOG_LEVEL=INFO
# Optional overrides. To use one, delete the "# " at the start of its line and add a value.
# BCS_SITE_NW_LAT=
# BCS_SITE_NW_LNG=
# BCS_MODEL_GEMINI_PRIMARY=
# BCS_MODEL_GEMINI_SECONDARY=
# BCS_MODEL_GEMINI_TREE=
# BCS_MODEL_OLLAMA=
# BCS_MODEL_IMAGE=
